# EventHub Environment Configuration Template
# Copy this file to .env and adjust variables as needed

# Base URL for API client
API_BASE_URL=http://localhost:3000

# Application Port
PORT=3000

# Environment Mode
NODE_ENV=development

# -----------------------------------------------------------------------------
# 🔐 Authentication & Demo Security Configuration
# -----------------------------------------------------------------------------
# Secret key used by the mock server to cryptographically sign HMAC-SHA256 JWTs
JWT_SECRET=replace-with-a-random-secret

# Distinct demo account credentials 
DEMO_ADMIN_PASSWORD=replace-with-admin-password
DEMO_HOST_PASSWORD=replace-with-host-password
DEMO_MANAGEMENT_PASSWORD=replace-with-management-password
DEMO_STAFF_PASSWORD=replace-with-staff-password
DEMO_USER_PASSWORD=replace-with-user-password
