# EventHub Environment Configuration Template
# Copy this file to .env and adjust variables as needed

# Base URL for API client
API_BASE_URL=http://localhost:3000

# Application Port
PORT=3000

# Environment Mode
NODE_ENV=development

# -----------------------------------------------------------------------------
# 🔐 Authentication & Demo Security Configuration
# -----------------------------------------------------------------------------
# Secret key used by the mock server to cryptographically sign HMAC-SHA256 JWTs
JWT_SECRET=eventhub-demo-cryptographic-jwt-secret-key-change-in-production

# Distinct demo account credentials 
DEMO_ADMIN_PASSWORD=Admin@EventHub#2026
DEMO_HOST_PASSWORD=Host@EventHub#2026
DEMO_MANAGEMENT_PASSWORD=Manage@EventHub#2026
DEMO_STAFF_PASSWORD=Staff@EventHub#2026
DEMO_USER_PASSWORD=User@EventHub#2026
